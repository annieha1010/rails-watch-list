<div class="banner" style="background-image: linear-gradient(rgba(0,0,0,0.4),rgba(0,0,0,0.4)), url(https://images.pexels.com/photos/7991486/pexels-photo-7991486.jpeg);">
  <div class="container">
    <h1>Save any kinds of <strong>movies</strong>!</h1>
    <p>Classic</p>
  </div>
</div>
<div>
  <%= link_to "Create a movie list", new_list_path, class: "btn btn-success" %>
</div>

<h1>My lists</h1>

<div class="cards">
  <% @lists.each do |list| %>
    <%= link_to list_path(list), class: 'text-dark text-decoration-none' do %>
      <div class="card-category" style="background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url(https://images.pexels.com/photos/3945317/pexels-photo-3945317.jpeg)">
      <%= list.name %>
      </div>
    <% end %>
  <% end %>
</div>
